{
  "name": "cluely-assistant",
  "version": "1.0.0",
  "description": "Evidence-driven independent desktop AI assistant with real-time screen and audio understanding",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "vite build",
