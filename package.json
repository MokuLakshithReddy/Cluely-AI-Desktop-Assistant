{
  "name": "cluely-copilot-root",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=app",
    "dev:vite": "npm run dev:vite --workspace=app",
    "build": "npm run build --workspace=app",
    "build:vite": "npm run build:vite --workspace=app",
    "build:electron": "npm run build:electron --workspace=app",
    "lint": "npm run lint --workspace=app",
    "test": "npm run test --workspace=app",
    "test:report": "npm run test:report --workspace=app",
    "smoke": "node app/tests/electron-smoke.cjs",
    "pack": "npm run pack --workspace=app",
    "dist:win": "npm run dist:win --workspace=app",
    "start": "npm run start --workspace=app"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.67.2"
  }
}
