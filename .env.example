# Optional local development environment variables for running standalone provider tests
# In desktop production, API keys are securely managed via the OS Credential Vault in Dashboard
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Exact Lemon Squeezy product/variant ID overrides for controlled local tests and CI.
# Both IDs must match the same Scandium plan; display names never grant entitlements.
LEMON_PLUS_PRODUCT_ID=
LEMON_PLUS_VARIANT_ID=
LEMON_PRO_PRODUCT_ID=
LEMON_PRO_VARIANT_ID=
